rules_version = '2';

// MVP: any signed-in user can read every brand. Tighten to
// `belongsToBrand(brandId)` (definition below) before onboarding real
// customers with data they shouldn't share.
// Writes still go through Cloud Functions (admin SDK) — client can't write
// to brand data. Per-user state (/users/{uid}/...) is user-owned.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToBrand(brandId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/brands/$(brandId)/members/$(request.auth.uid));
    }

    match /brands/{brandId} {
      // MVP-wide read: any signed-in user sees every brand's dashboard.
      allow read: if isSignedIn();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // Reference images: any signed-in user can upload/delete during MVP.
      match /referenceImages/{docId} {
        allow read: if isSignedIn();
        allow create, delete: if isSignedIn();
        allow update: if false;
      }

      // Everything else (creators, posts, detections, resonance, edges,
      // discoveryQueue, hashtagPool, imageHashCache, scanRuns, usage,
      // scrapeLog, detectLog, videoLog) — signed-in read, server-only write.
      match /{subcollection}/{document=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Per-user state: signed-in user owns their own /users/{uid} tree.
    // Used for inbox, shortlist, saved views.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /{anySub}/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
