rules_version = '2';

// MVP: any signed-in user can read every brand. Tighten to
// `belongsToBrand(brandId)` (definition below) before onboarding real
// customers with data they shouldn't share.
// Writes still go through Cloud Functions (admin SDK) — client can't write
// to brand data. Per-user state (/users/{uid}/...) is user-owned.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function belongsToBrand(brandId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/brands/$(brandId)/members/$(request.auth.uid));
    }

    match /brands/{brandId} {
      // MVP-wide read: any signed-in user sees every brand's dashboard.
      allow read: if isSignedIn();
      allow write: if false;

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // Reference images: brand members only.
      //
      // These are what the detector is shown as "this is the product" on every
      // Gemini call, so deleting one silently changes what the AI recognises
      // for everyone. This previously allowed any signed-in account to create
      // and delete them, which is not a permission an outside tester should
      // hold — and it disagreed with storage.rules, which already required
      // membership for the blob. That mismatch meant a non-member's delete
      // removed the Firestore doc (the thing that actually selects refs) while
      // the blob survived: the ref was gone from the AI, and the app reported
      // success. Matching the two rulesets closes both halves.
      match /referenceImages/{docId} {
        allow read: if isSignedIn();
        allow create, delete: if belongsToBrand(brandId);
        allow update: if false;
      }

      // Everything else (creators, posts, detections, resonance, edges,
      // discoveryQueue, hashtagPool, imageHashCache, scanRuns, usage,
      // scrapeLog, detectLog, videoLog) — signed-in read, server-only write.
      match /{subcollection}/{document=**} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Per-user state: signed-in user owns their own /users/{uid} tree.
    // Used for inbox, shortlist, saved views.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
      match /{anySub}/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
