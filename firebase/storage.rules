rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Cached thumbnails: publicly readable (so <img src> works without auth),
    // server-write-only.
    match /thumbnails/{brandId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Reference images: brand members can upload/replace/delete, public read
    // (Gemini needs to fetch them as part of the detection prompt).
    match /references/{brandId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/brands/$(brandId)/members/$(request.auth.uid))
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
        && firestore.exists(/databases/(default)/documents/brands/$(brandId)/members/$(request.auth.uid));
    }
  }
}
